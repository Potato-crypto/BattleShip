<Window x:Class="BattleShip.Client.GameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BattleShip.Client"
        Title="Морской Бой - Подготовка к игре" 
        Height="800" 
        Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#0c2461">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок с кнопкой назад -->
        <Border Grid.Row="0" 
                Background="#1e3c72" 
                Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Кнопка назад -->
                <Button Grid.Column="0"
                        Content="← Назад"
                        Width="100"
                        Height="35"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="White"
                        Background="#4a69bd"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="BackButton_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <!-- Заголовок -->
                <TextBlock Grid.Column="1"
                           Text="МОРСКОЙ БОЙ"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                <!-- Статус подключения -->
                <Border Grid.Column="2"
                        Background="#4a69bd"
                        CornerRadius="15"
                        Padding="10,5">
                    <TextBlock x:Name="ConnectionStatus"
                               Text="Не подключено"
                               Foreground="White"
                               FontSize="12"
                               FontWeight="Bold"/>
                </Border>
            </Grid>
        </Border>

        <!-- Основное содержимое - два поля -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Левое поле - Ваше поле -->
            <Border Grid.Column="0"
                    Background="#16213e"
                    CornerRadius="10"
                    BorderBrush="#4a69bd"
                    BorderThickness="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок левого поля -->
                    <Border Grid.Row="0"
                            Background="#4a69bd"
                            CornerRadius="10,10,0,0"
                            Padding="10">
                        <TextBlock Text="ВАШЕ ПОЛЕ"
                                  Foreground="White"
                                  FontSize="18"
                                  FontWeight="Bold"
                                  HorizontalAlignment="Center"/>
                    </Border>

                    <!-- Игровое поле (сетка 10x10) -->
                    <Border Grid.Row="1"
                            Margin="20"
                            BorderBrush="#6a89cc"
                            BorderThickness="1"
                            Background="#0f3460"
                            CornerRadius="5">
                        <Grid x:Name="YourBoardGrid"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Margin="10">
                            <!-- Сетка будет создана в коде -->
                        </Grid>
                    </Border>

                    <!-- Панель управления -->
                    <StackPanel Grid.Row="2"
                                Background="#1e3c72"
                                Height="120">
                        <StackPanel Margin="10" 
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center">

                            <!-- Кнопка очистки поля -->
                            <Button x:Name="ClearBoardButton"
                                    Content="🗑️ Очистить поле"
                                    Width="200"
                                    Height="35"
                                    Background="#e74c3c"
                                    Foreground="White"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Margin="0,0,0,5"
                                    Click="ClearBoardButton_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="5"/>
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <!-- Информация о кораблях -->
                            <TextBlock x:Name="ShipsInfo"
                                       Text="Осталось расставить: 1x4, 2x3, 3x2, 4x1"
                                       Foreground="White"
                                       FontSize="12"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,5"/>

                            <!-- Кнопка случайной расстановки -->
                            <Button x:Name="RandomPlacementButton"
                                    Content="🎲 Расставить случайно"
                                    Width="200"
                                    Height="35"
                                    Background="#4a69bd"
                                    Foreground="White"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="RandomPlacementButton_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="5"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Разделитель -->
            <Border Grid.Column="1"
                    Background="#4a69bd"
                    Width="2"
                    Opacity="0.3"/>

            <!-- Правое поле - Поле противника -->
            <Border Grid.Column="2"
                    Background="#16213e"
                    CornerRadius="10"
                    BorderBrush="#4a69bd"
                    BorderThickness="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок правого поля -->
                    <Border Grid.Row="0"
                            Background="#4a69bd"
                            CornerRadius="10,10,0,0"
                            Padding="10">
                        <TextBlock Text="ПОЛЕ ПРОТИВНИКА"
                                  Foreground="White"
                                  FontSize="18"
                                  FontWeight="Bold"
                                  HorizontalAlignment="Center"/>
                    </Border>

                    <!-- Игровое поле противника -->
                    <Border Grid.Row="1"
                            Margin="20"
                            BorderBrush="#6a89cc"
                            BorderThickness="1"
                            Background="#0f3460"
                            CornerRadius="5">
                        <Grid x:Name="OpponentBoardGrid"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Margin="10">
                            <!-- Сетка будет создана в коде -->
                        </Grid>
                    </Border>

                    <!-- Панель кнопок под правым полем -->
                    <StackPanel Grid.Row="2"
                                Background="#1e3c72"
                                Height="120">
                        <StackPanel Margin="10" 
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center">

                            <!-- Кнопка "Играть с другом" -->
                            <Button x:Name="PlayWithFriendButton"
                                    Content="🎮 Играть с другом"
                                    Width="200"
                                    Height="35"
                                    Background="#4a69bd"
                                    Foreground="White"
                                    BorderThickness="0"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Cursor="Hand"
                                    Margin="0,0,0,5"
                                    Click="PlayWithFriendButton_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <!-- Кнопка "Случайный соперник" -->
                            <Button x:Name="RandomOpponentButton"
                                    Content="🎲 Случайный соперник"
                                    Width="200"
                                    Height="35"
                                    Background="#6a89cc"
                                    Foreground="White"
                                    BorderThickness="0"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Cursor="Hand"
                                    Margin="0,0,0,5"
                                    Click="RandomOpponentButton_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <!-- Индикатор поиска -->
                            <Border x:Name="SearchIndicator"
                                    Background="#1e3c72"
                                    CornerRadius="8"
                                    Padding="10"
                                    Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center">
                                    <!-- Анимация поиска -->
                                    <Grid Margin="0,0,0,5">
                                        <Ellipse Width="30" Height="30" Stroke="#4a69bd" StrokeThickness="3">
                                            <Ellipse.Triggers>
                                                <EventTrigger RoutedEvent="Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimation
                                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                From="0" To="360" Duration="0:0:2"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Ellipse.Triggers>
                                            <Ellipse.RenderTransform>
                                                <RotateTransform CenterX="15" CenterY="15"/>
                                            </Ellipse.RenderTransform>
                                        </Ellipse>
                                        <TextBlock Text="🔍"
                                                  FontSize="16"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                    </Grid>

                                    <TextBlock x:Name="SearchStatus"
                                              Text="Поиск соперника..."
                                              Foreground="White"
                                              FontSize="12"
                                              HorizontalAlignment="Center"
                                              Margin="0,0,0,5"/>

                                    <Button x:Name="CancelSearchButton"
                                            Content="Отменить поиск"
                                            Width="120"
                                            Height="25"
                                            Background="#e74c3c"
                                            Foreground="White"
                                            FontSize="11"
                                            FontWeight="Bold"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Click="CancelSearchButton_Click">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="5"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Статус игры, таймер и кнопка чата внизу -->
        <Border Grid.Row="2"
                Background="#1e3c72"
                Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <!-- ✅ ТАЙМЕР -->
                    <ColumnDefinition Width="*"/>
                    <!-- ✅ СТАТУС -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- ✅ КНОПКА ЧАТА -->
                </Grid.ColumnDefinitions>

                <!-- ✅ ТАЙМЕР ХОДА (новый элемент) -->
                <Border Grid.Column="0"
                        x:Name="TurnTimerContainer"
                        Background="#4a69bd"
                        CornerRadius="15"
                        Padding="10,5"
                        Margin="10,0"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⏱️"
                                  Foreground="White"
                                  FontSize="16"
                                  Margin="0,0,5,0"
                                  VerticalAlignment="Center"/>
                        <TextBlock x:Name="TurnTimeTextBlock"
                                  Text="Ход: 30 сек"
                                  Foreground="White"
                                  FontSize="12"
                                  FontWeight="Bold"
                                  VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Статус игры -->
                <TextBlock x:Name="GameStatus"
                          Text="Подготовка к игре - расставьте корабли на вашем поле"
                          Foreground="White"
                          FontSize="14"
                          HorizontalAlignment="Center"
                          Grid.Column="1"/>

                <!-- Кнопка открытия чата со счетчиком -->
                <Button x:Name="OpenChatButton"
                        Width="100"
                        Height="30"
                        Background="#2ecc71"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="12"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Visibility="Collapsed"
                        Click="OpenChatButton_Click"
                        Grid.Column="2"
                        Margin="10,0,0,0">
                    <Grid>
                        <TextBlock Text="💬 Чат" 
                                  VerticalAlignment="Center" 
                                  HorizontalAlignment="Center"/>

                        <!-- Счетчик непрочитанных сообщений -->
                        <Border x:Name="UnreadBadge"
                                Background="#e74c3c"
                                CornerRadius="10"
                                Width="20"
                                Height="20"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,-5,-5,0"
                                Visibility="Collapsed">
                            <TextBlock x:Name="UnreadCountText"
                                      Text="0"
                                      Foreground="White"
                                      FontSize="10"
                                      FontWeight="Bold"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>

        <!-- Окно чата (в правом нижнем углу) -->
        <local:ChatControl x:Name="ChatWindowControl"
                           Grid.Row="1"
                           Grid.RowSpan="2"
                           Width="300"
                           Height="400"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Bottom"
                           Margin="20"
                           Visibility="Collapsed"
                           IsHitTestVisible="True"/>
    </Grid>
</Window>